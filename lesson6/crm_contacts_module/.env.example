# CRM Contacts Module - Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
# IMPORTANT: Change these credentials in production!
DATABASE_URL=postgresql://user:your_secure_password@localhost:5432/crm_db

# PostgreSQL settings (used by Docker)
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=crm_db

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
